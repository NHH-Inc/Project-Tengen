{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frc-video-scouting/contracts/result.schema.json",
  "title": "Analysis run metadata (Contract D result.json, v3)",
  "description": "Written by component 1 to <out>/result.json. Key names are pinned by doc 0.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version", "job_id", "model_version", "box_sample_rate", "homography_ok",
    "frames_total", "frames_analyzed", "frames_skipped_shot_change",
    "tracks_emitted", "events_emitted", "reconstructed_score", "started_at", "finished_at"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 3 },
    "job_id": { "type": "string", "format": "uuid" },
    "model_version": { "type": "string" },
    "box_sample_rate": {
      "type": "number",
      "exclusiveMinimum": 0,
      "description": "Hertz -- samples per second, not a frame interval. Served to component 3 on the tracks response."
    },
    "homography_ok": { "type": "boolean" },
    "homography_source": {
      "type": ["string", "null"],
      "description": "carpet_pose or tag_plane; null when no mapping was applied."
    },
    "frames_total": { "type": "integer", "minimum": 0 },
    "frames_analyzed": { "type": "integer", "minimum": 0 },
    "raw_tracks_path": {
      "type": ["string", "null"],
      "description": "Immutable raw tracker-tracklet sidecar used by the stable identity layer."
    },
    "frames_skipped_shot_change": { "type": "integer", "minimum": 0 },
    "tracks_emitted": { "type": "integer", "minimum": 0 },
    "events_emitted": { "type": "integer", "minimum": 0 },
    "reconstructed_score": {
      "description": "Null while the season's point values are placeholders.",
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["red", "blue"],
          "properties": { "red": { "type": "integer" }, "blue": { "type": "integer" } }
        }
      ]
    },
    "started_at": { "type": "string", "format": "date-time" },
    "finished_at": { "type": "string", "format": "date-time" }
  }
}
