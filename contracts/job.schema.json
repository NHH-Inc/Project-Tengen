{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frc-video-scouting/contracts/job.schema.json",
  "title": "Job record (Contract A, v3)",
  "description": "Produced by component 2. Consumed by components 1 and 3.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version", "job_id", "match_id", "season", "video_id", "local_path",
    "start_offset", "duration", "fps", "width", "height", "status", "stage",
    "progress", "error_code", "error", "attempt", "created_at", "updated_at",
    "alliances", "tba_score"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 3 },
    "job_id": { "type": "string", "format": "uuid" },
    "match_id": {
      "type": ["string", "null"],
      "pattern": "^[0-9]{4}[a-z0-9]+_[a-z0-9]+$",
      "description": "TBA match key, lowercase. Null when resolution from video metadata fails."
    },
    "season": {
      "type": "integer",
      "description": "Selects /contracts/seasons/<year>.json, so old footage stays analyzable after the game changes."
    },
    "video_id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{11}$" },
    "local_path": { "type": ["string", "null"] },
    "start_offset": { "type": "number", "minimum": 0 },
    "duration": { "type": ["number", "null"], "exclusiveMinimum": 0 },
    "fps": { "type": ["number", "null"], "exclusiveMinimum": 0 },
    "width": { "type": ["integer", "null"], "exclusiveMinimum": 0 },
    "height": { "type": ["integer", "null"], "exclusiveMinimum": 0 },
    "status": {
      "type": "string",
      "enum": ["queued", "downloading", "downloaded", "analyzing", "complete", "failed"]
    },
    "stage": {
      "type": ["string", "null"],
      "enum": ["downloading", "decoding", "detecting", "tracking", "ocr", "events", null]
    },
    "progress": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "error_code": {
      "type": ["string", "null"],
      "enum": ["video_unavailable", "download_failed", "rate_limited", "no_match_data",
               "analysis_failed", "timeout", "internal", null]
    },
    "error": { "type": ["string", "null"] },
    "attempt": { "type": "integer", "minimum": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "alliances": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["red", "blue"],
          "properties": {
            "red":  { "type": "array", "items": { "type": "integer", "exclusiveMinimum": 0 }, "minItems": 3, "maxItems": 3 },
            "blue": { "type": "array", "items": { "type": "integer", "exclusiveMinimum": 0 }, "minItems": 3, "maxItems": 3 }
          }
        }
      ]
    },
    "tba_score": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["red", "blue"],
          "properties": { "red": { "type": "integer" }, "blue": { "type": "integer" } }
        }
      ]
    }
  },
  "allOf": [
    {
      "$comment": "Doc 0: stream media metadata must be non-null once status is downloaded/analyzing/complete. local_path stays null for yt-dlp stream jobs.",
      "if": { "properties": { "status": { "enum": ["downloaded", "analyzing", "complete"] } }, "required": ["status"] },
      "then": {
        "properties": {
          "duration": { "type": "number" },
          "fps": { "type": "number" },
          "width": { "type": "integer" },
          "height": { "type": "integer" }
        }
      }
    },
    {
      "$comment": "Doc 0: error_code and error must be non-null when status is failed.",
      "if": { "properties": { "status": { "const": "failed" } }, "required": ["status"] },
      "then": {
        "properties": {
          "error_code": {
            "type": "string",
            "enum": ["video_unavailable", "download_failed", "rate_limited", "no_match_data",
                     "analysis_failed", "timeout", "internal"]
          },
          "error": { "type": "string" }
        }
      }
    }
  ]
}
