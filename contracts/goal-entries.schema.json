{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frc-video-scouting/contracts/goal-entries.schema.json",
  "title": "Observed physical goal entry (v1)",
  "description": "One observed ball entering a calibrated basket. Independent of launch detection and official point scoring. Unknown sources remain null.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "entry_id", "goal", "region_id", "ball_track_id", "frame_index", "t_seconds", "crossing_frame", "crossing_t_seconds", "confidence", "shot_id", "robot_track_id", "association", "association_confidence", "coordinate_space", "ball_track"],
  "properties": {
    "schema_version": {"const": 1},
    "entry_id": {"type": "string", "format": "uuid"},
    "goal": {"type": "string", "minLength": 1},
    "region_id": {"type": "string", "minLength": 1},
    "ball_track_id": {"type": "integer", "minimum": 1},
    "frame_index": {"type": "integer", "minimum": 0},
    "t_seconds": {"type": "number", "minimum": 0},
    "crossing_frame": {"type": "integer", "minimum": 0},
    "crossing_t_seconds": {"type": "number", "minimum": 0},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "shot_id": {"type": ["string", "null"], "format": "uuid"},
    "robot_track_id": {"type": ["integer", "null"]},
    "association": {"enum": ["unassigned", "same_track", "trajectory_relink"]},
    "association_confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "coordinate_space": {"const": "model_crop_normalized"},
    "ball_track": {
      "type": "array", "minItems": 2,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["frame_index", "t_seconds", "x", "y", "radius", "observed"],
        "properties": {
          "frame_index": {"type": "integer", "minimum": 0},
          "t_seconds": {"type": "number", "minimum": 0},
          "x": {"type": "number", "minimum": 0, "maximum": 1},
          "y": {"type": "number", "minimum": 0, "maximum": 1},
          "radius": {"type": "number", "minimum": 0},
          "observed": {"const": true}
        }
      }
    }
  }
}
