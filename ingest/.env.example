# Copy to ingest/.env and fill in. Never commit the real file -- .env is gitignored.
# Everything here is optional; the service runs without it, degrading rather than failing.

# --- The Blue Alliance -------------------------------------------------------
# Free key from https://www.thebluealliance.com/account (Read API Keys).
# Without it, `alliances` and `tba_score` stay null: bumper OCR loses process-of-elimination
# down to three candidates per side, and the reconstructed-vs-official accuracy check has
# nothing to compare against.
TBA_API_KEY=

# --- Google Sheets export ----------------------------------------------------
# Two routes. Configure EITHER; the service account wins if both are set. They write the same
# rows with the same stable keys, so the choice is about what your Google account permits.
#
# Route A -- service account. Needs Google Cloud.
#   1. Google Cloud console -> create a service account -> download its JSON key
#   2. Share the target spreadsheet with that service account's email (Editor)
#   3. Point the two variables below at the key file and the spreadsheet id
SHEETS_SPREADSHEET_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# Route B -- Apps Script. Use this when Google Cloud is unavailable, which is the normal state
# of a school Workspace account: an administrator has disabled it and no code change helps.
# A script bound to the sheet runs as its owner inside Workspace -- no Cloud project, no service
# account, no key file.
#
#   1. Spreadsheet -> Extensions -> Apps Script, paste tools/apps-script/Code.gs
#   2. Set SECRET in that script to a long random string
#   3. Deploy -> New deployment -> Web app; Execute as "Me", Who has access "Anyone"
#   4. Put the /exec URL and the SAME secret here
#
# "Anyone" is required because this service is not a signed-in Google user, which is exactly why
# the secret exists -- it, not the URL, is what stops a stranger writing to your sheet.
# Full walkthrough: tools/apps-script/README.md
APPS_SCRIPT_URL=
APPS_SCRIPT_SECRET=

# With neither route configured, POST /api/export/sheets returns 503 rather than reporting a
# write that did not happen. With one configured but failing -- a wrong secret, a dead URL --
# it returns 502 and says why.

# --- Storage and runtime -----------------------------------------------------
# SQLite by default. This file is loaded automatically by the service. For a SHARED instance use managed Postgres -- see
# docs/CENTRAL-SETUP.md. Only the machine hosting the service needs this; everyone else
# talks to that service over HTTP and needs no database access at all.
#   DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
#
# Supabase: use the POOLER host on port 6543, not 5432. Port 5432 is session mode and is closed
# on these projects; it fails with "server closed the connection unexpectedly", which reads like
# an outage rather than a wrong port. Copy the "Transaction pooler" string from the Supabase
# dashboard, not the "Direct connection" one -- the direct host does not resolve at all.
DATABASE_URL=sqlite:///./frc_scouting.db

# Extra browser origins allowed to call this service, comma separated. Only needed when
# someone runs a separate Vite dev server, especially from another machine. `run.ps1 serve`
# is same-origin and needs none of this.
FRC_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Segments land in $FRC_DATA_DIR/segments, job output in $FRC_DATA_DIR/jobs.
FRC_DATA_DIR=./data

ANALYSIS_BINARY=./analysis/build/bin/analysis

# --- YOLO + ByteTrack analysis (optional) -----------------------------------
# The service selects YOLO automatically when both the dedicated Python runtime and model exist.
# Set FRC_ANALYSIS_BACKEND=native to force the C++ RF-DETR backend instead.
FRC_ANALYSIS_BACKEND=auto
YOLO_PYTHON=
YOLO_MODEL_PATH=./data/models/yolo11n-frc-robots-20260901/weights/best.pt
FRC_YOLO_TRACKER=bytetrack
FRC_YOLO_CONFIDENCE=0.25
FRC_YOLO_IMAGE_SIZE=960
FRC_YOLO_DEVICE=0
FRC_YOLO_SAVE_ANNOTATED=0
# Optional AprilTag/camera-pose calibration. When set, YOLO and native tracks include carpet
# positions and finite-difference speed; leave empty when the camera shot has no valid calibration.
FRC_HOMOGRAPHY_CONFIG=

# Used when a job does not name a season. Must have a contracts/seasons/<year>.json.
FRC_DEFAULT_SEASON=2026

# YouTube sometimes answers "Sign in to confirm you're not a bot". It is intermittent rather than
# a block -- retrying usually works -- but it recurs when fetching many videos in a row. Either
# setting below supplies cookies; the file wins if both are set.
#
# On Windows, prefer the FILE. yt-dlp can no longer read Chrome's cookie store there (Chrome
# encrypts it with app-bound DPAPI; yt-dlp issue 10927), so the browser option fails with
# "Failed to decrypt with DPAPI". Firefox still works.
#
# Export cookies.txt with a browser extension while signed in, and use a THROWAWAY Google
# account -- these requests are made as whoever exported them.
# YTDLP_COOKIES_FILE=C:\path\to\cookies.txt
# YTDLP_COOKIES_FROM_BROWSER=firefox
